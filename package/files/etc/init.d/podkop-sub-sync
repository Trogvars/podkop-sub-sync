#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

start_service(){
    enabled="$(uci -q get podkop-sub-sync.main.enabled 2>/dev/null || true)"
    [ "$enabled" = "1" ] || return 0

    procd_open_instance
    procd_set_param command /bin/ash /usr/bin/podkop-sub-sync-daemon
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers(){
    procd_add_reload_trigger podkop-sub-sync
}
