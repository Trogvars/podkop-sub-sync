#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

start_service(){
    rm -rf /tmp/podkop-sub-sync-schedule
    mkdir -p /tmp/podkop-sub-sync-schedule

    procd_open_instance
    procd_set_param command /bin/ash /usr/bin/podkop-sub-sync-daemon
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers(){
    procd_add_reload_trigger podkop-sub-sync
}
